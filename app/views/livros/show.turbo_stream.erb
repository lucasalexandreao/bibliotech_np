<%= turbo_stream.update "modal" do %>
  <div class="fixed inset-0 bg-gray-900/20 backdrop-blur-sm flex items-center justify-center z-50 p-4 transition-all duration-300" onclick="if(event.target === this) document.getElementById('modal').innerHTML=''">
    
    <div class="bg-white rounded-lg shadow-2xl border border-gray-200 w-full max-w-3xl max-h-[90vh] overflow-y-auto relative animate-fade-in-up">
      
      <button type="button" onclick="document.getElementById('modal').innerHTML=''" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-full p-1 transition-colors">
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="p-8">
        
        <div class="mb-6 pb-4 pr-8">
          <h1 class="text-2xl font-bold text-gray-800"><%= @livro.titulo %></h1>
          <div class="mt-2 inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-gray-100 text-gray-800 border border-gray-200">
            ID do Exemplar: #<%= @livro.id %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <div class="flex justify-center md:justify-start">
            <% if @livro.capa.present? %>
              <%= image_tag @livro.capa.url, class: "w-48 h-64 object-cover rounded-lg shadow-md border border-gray-200" %>
            <% else %>
              <div class="w-48 h-64 bg-gray-100 rounded-lg border border-gray-200 flex items-center justify-center text-gray-400">Sem Capa</div>
            <% end %>
          </div>

          <div class="md:col-span-2 space-y-4">
            <p><strong class="text-gray-700">Autor:</strong> <%= @livro.autor %></p>
            
            <p><strong class="text-gray-700">Categoria:</strong> 
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= @livro.categoria.nome %></span>
            </p>
            
            <p>
              <strong class="text-gray-700">Status:</strong> 
              <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= @livro.disponivel? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                <%= @livro.status.humanize %>
              </span>
            </p>

            <% if @livro.observacoes.present? %>
              <div class="pt-4 mt-2">
                <strong class="text-gray-700 block mb-1">Observações:</strong>
                <p class="text-sm text-gray-600 bg-gray-50 p-3 rounded border border-gray-200"><%= @livro.observacoes %></p>
              </div>
            <% end %>
          </div>
        </div>
        
        <div class="mt-8 pt-4 flex justify-end gap-3">
          <button type="button" onclick="document.getElementById('modal').innerHTML=''" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded transition-colors">
            Voltar
          </button>
          
          <%= link_to "Editar Livro", edit_livro_path(@livro), data: { turbo_stream: true }, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded transition-colors" %>
        </div>
      </div>

    </div>
  </div>
<% end %>