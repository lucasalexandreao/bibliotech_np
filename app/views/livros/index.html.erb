<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Acervo de Livros</h1>
    <%= link_to "Novo Livro", new_livro_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>

<%= search_form_for @q, url: livros_path, data: { turbo_frame: "resultados_livros" }, class: "mb-6 grid grid-cols-1 md:grid-cols-4 gap-4 items-end bg-gray-50 p-4 rounded-md border border-gray-200" do |f| %>
    <div>
      <%= f.label :titulo_cont, "Título", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :titulo_cont, class: "w-full rounded-md border-gray-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border", placeholder: "Título...", oninput: "this.form.requestSubmit()" %>
    </div>

    <div>
      <%= f.label :autor_cont, "Autor", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :autor_cont, class: "w-full rounded-md border-gray-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border", placeholder: "Autor...", oninput: "this.form.requestSubmit()" %>
    </div>

    <div>
      <%= f.label :categoria_id_eq, "Categoria", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :categoria_id_eq, Categoria.order(:nome).pluck(:nome, :id), { include_blank: "Todas" }, class: "w-full rounded-md border-gray-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border bg-white", onchange: "this.form.requestSubmit()" %>
    </div>

    <div>
      <%= f.label :status_eq, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :status_eq, Livro.statuses.map { |k, v| [k.humanize, v] }, { include_blank: "Todos" }, class: "w-full rounded-md border-gray-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border bg-white", onchange: "this.form.requestSubmit()" %>
    </div>
  <% end %>

  <%= turbo_frame_tag "resultados_livros" do %>
    <div class="overflow-x-auto mb-4 border border-gray-200 rounded-lg shadow-sm">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Capa</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(@q, :titulo, "Título") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(@q, :autor, "Autor") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoria</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(@q, :status, "Status") %></th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @livros.each do |livro| %>
            <tr>
              <td class="px-4 py-3 whitespace-nowrap">
                <% if livro.capa.present? %>
                  <%= image_tag livro.capa.url, class: "w-12 h-16 object-cover rounded shadow-sm border border-gray-200" %>
                <% else %>
                  <div class="w-12 h-16 bg-gray-100 rounded border border-gray-200 flex items-center justify-center text-gray-400 text-xs">Sem Capa</div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900"><%= livro.titulo %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= livro.autor %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  <%= livro.categoria.nome %>
                </span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-center">
                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= livro.disponivel? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                  <%= livro.status.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end items-center space-x-3">
                  <% if livro.disponivel? %>
                    <%= link_to new_livro_emprestimo_path(livro), data: { turbo_frame: "_top" }, class: "text-green-600 hover:text-green-900 transition-colors", title: "Realizar Empréstimo" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                      </svg>
                    <% end %>
                  <% end %>
                  
                  <%= link_to livro_path(livro), data: { turbo_frame: "_top" }, class: "text-gray-600 hover:text-gray-900 transition-colors", title: "Detalhes" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  <% end %>

                  <%= link_to edit_livro_path(livro), data: { turbo_frame: "_top" }, class: "text-indigo-600 hover:text-indigo-900 transition-colors", title: "Editar" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                    </svg>
                  <% end %>

                  <%= button_to livro_path(livro), method: :delete, data: { turbo_confirm: "Tem certeza de que deseja remover este livro do acervo?", turbo_frame: "_top" }, class: "text-red-600 hover:text-red-900 transition-colors", title: "Excluir" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @livros.empty? %>
        <div class="p-6 text-center text-gray-500">Nenhum livro encontrado no acervo.</div>
      <% end %>
    </div>

    <div class="flex justify-center mt-4">
      <%== @pagy.series_nav if @pagy.pages > 1 %>
    </div>
  <% end %>
</div>