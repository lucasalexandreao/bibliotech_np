<div class="max-w-4xl mx-auto mt-10">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Meus Empréstimos</h1>
    <%= button_to "Sair", portal_logout_path, method: :delete, class: "text-red-600 hover:text-red-800 font-medium" %>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-md border border-gray-200">
    <ul class="divide-y divide-gray-200">
      <% @emprestimos.each do |emp| %>
        <li>
          <div class="px-4 py-4 sm:px-6 flex items-center justify-between">
            <div class="flex flex-col">
              <p class="text-lg font-medium text-blue-600 truncate"><%= emp.livro.titulo %></p>
              <div class="mt-2 flex items-center text-sm text-gray-500">
                <span class="mr-4">Retirado em: <%= l(emp.data_emprestimo) %></span>
                <span class="font-bold <%= emp.data_devolucao_prevista < Date.current ? 'text-red-600' : 'text-gray-700' %>">
                  Devolver até: <%= l(emp.data_devolucao_prevista) %>
                </span>
              </div>
            </div>
            
            <div class="flex-shrink-0">
              <% if emp.pode_ser_renovado? %>
                <%= button_to "Renovar", portal_renovar_path(emp), method: :patch, class: "bg-green-100 hover:bg-green-200 text-green-800 font-bold py-2 px-4 rounded transition-colors border border-green-300" %>
              <% else %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-red-100 text-red-800">
                  Renovação Indisponível
                </span>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>

      <% if @emprestimos.empty? %>
        <div class="p-6 text-center text-gray-500">Você não possui livros pendentes no momento.</div>
      <% end %>
    </ul>
  </div>
</div>