<div id="modal"></div>
<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Gestão de Equipe</h1>
    <%= link_to "Novo Bibliotecário", new_gestao_bibliotecario_path, data: { turbo_stream: true }, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

<%= search_form_for @q, url: gestao_bibliotecarios_path, data: { turbo_frame: "resultados_pesquisa" }, class: "mb-6 flex gap-4 items-end bg-gray-50 p-4 rounded-md border border-gray-200" do |f| %>
    <div class="flex-1">
      <%= f.label :nome_cont, "Buscar por Nome", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nome_cont, class: "w-full rounded-md border-gray-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border", placeholder: "Digite parte do nome...", oninput: "this.form.requestSubmit()" %>
    </div>
    
    <div class="flex-1">
      <%= f.label :email_cont, "Buscar por E-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :email_cont, class: "w-full rounded-md border-gray-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border", placeholder: "Digite o e-mail...", oninput: "this.form.requestSubmit()" %>
    </div>

    <div>
      <%= f.label :papel_eq, "Nível de Acesso", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :papel_eq, Bibliotecario.papeis.keys.map { |r| [r.capitalize, Bibliotecario.papeis[r]] }, { include_blank: "Todos" }, class: "w-full rounded-md border-gray-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border bg-white", onchange: "this.form.requestSubmit()" %>
    </div>

    <div class="flex gap-2">
      <%= link_to "Limpar", gestao_bibliotecarios_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded" %>
    </div>
  <% end %>

  <%= turbo_frame_tag "resultados_pesquisa" do %>
    <div class="overflow-x-auto mb-4 border border-gray-200 rounded-lg shadow-sm">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= sort_link(@q, :nome, "Nome", default_order: :asc) %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= sort_link(@q, :email, "E-mail") %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= sort_link(@q, :papel, "Acesso") %>
            </th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @bibliotecarios.each do |bib| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= bib.nome %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= bib.email %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= bib.admin? ? 'bg-purple-100 text-purple-800' : 'bg-green-100 text-green-800' %>">
                  <%= bib.papel.capitalize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <div class="flex justify-end items-center space-x-3">
                <%= link_to edit_gestao_bibliotecario_path(bib), data: { turbo_stream: true }, class: "text-indigo-600 hover:text-indigo-900 transition-colors", title: "Editar" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                  </svg>
                <% end %>

                <% if bib != current_bibliotecario %>
                  <%= button_to gestao_bibliotecario_path(bib), method: :delete, data: { turbo_confirm: "Tem certeza que deseja remover este bibliotecário?", turbo_frame: "_top" }, class: "text-red-600 hover:text-red-900 transition-colors", title: "Excluir" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <% if @bibliotecarios.empty? %>
        <div class="p-6 text-center text-gray-500">Nenhum registro encontrado.</div>
      <% end %>
    </div>

    <div class="flex justify-center mt-4">
      <%== @pagy.series_nav if @pagy.pages > 1 %>
    </div>
  <% end %>
</div>