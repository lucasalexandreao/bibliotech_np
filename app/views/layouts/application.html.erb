<!DOCTYPE html>
<html>
  <head>
    <title>Biblioteca Municipal Ney Pontes</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
  </head>

  <body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">
    <header class="bg-blue-800 text-white shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="font-bold text-xl">
          📚 Biblioteca Ney Pontes
        </div>
        <nav>
          <% if bibliotecario_signed_in? %>
            <span class="mr-4 text-sm">Olá, <%= current_bibliotecario.nome %></span>
            <%= button_to "Sair", destroy_bibliotecario_session_path, method: :delete, class: "text-blue-200 hover:text-white text-sm font-semibold" %>
          <% end %>
        </nav>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
      <% flash.each do |key, message| %>
        <div class="p-4 mb-4 rounded shadow-sm <%= key == 'notice' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
          <%= message %>
        </div>
      <% end %>
    </div>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <%= yield %>
    </main>

    <footer class="bg-white border-t border-gray-200 py-4 mt-auto">
      <div class="max-w-7xl mx-auto px-4 text-center text-sm text-gray-500">
        &copy; <%= Time.current.year %> - Prefeitura de Mossoró/RN. Desafio de Estágio.
      </div>
    </footer>
  </body>
</html>