<div class="max-w-md mx-auto bg-white p-8 border border-gray-200 rounded-lg shadow-lg mt-10">
  <h2 class="text-2xl font-bold text-center text-blue-800 mb-6">Esqueci minha senha</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
    </div>

    <div class="pt-2">
      <%= f.submit "Enviar instruções por e-mail", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-4 text-center text-sm">
    <%= link_to "Voltar para o login", new_session_path(resource_name), class: "text-blue-600 hover:text-blue-500" %>
  </div>
</div>